DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/cyber_shield
JWT_SECRET=generate-a-secure-random-secret-key-min-32-chars
JWT_EXPIRES_MINUTES=60
JWT_REFRESH_EXPIRES_DAYS=14
PORT=8001
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=524288000
PASSWORD_RESET_EXPIRES_MINUTES=60
EXPOSE_RESET_TOKEN=true

# AI / intelligence (optional — local/rule-based fallbacks are used when unset)
AI_PROVIDER=local
AI_API_KEY=
MODEL_NAME=gpt-4o-mini
OCR_ENGINE=auto
WHISPER_MODEL=base
RISK_LOW_MAX=25
RISK_MEDIUM_MAX=50
RISK_HIGH_MAX=75
EVIDENCE_REPOSITORY_DIR=evidence_repository
